{
  "name": "@tivility/dsh-compaction-window",
  "version": "0.1.0",
  "description": "Per-session working context window and compaction settings override for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "lib/**",
    "src/**"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "context-window",
    "session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tivility/dsh-plugins.git",
    "directory": "packages/compaction-window"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "*",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "*",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
