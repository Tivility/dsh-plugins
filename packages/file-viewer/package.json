{
  "name": "@tivility/dsh-file-viewer",
  "version": "0.1.0",
  "description": "Read-only browser preview of DeepSeek Harness workspace files: directory listings, rendered Markdown, inline media, and raw bytes.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "lib/**",
    "src/**"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "file-browser",
    "markdown",
    "readonly"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tivility/dsh-plugins.git",
    "directory": "packages/file-viewer"
  },
  "dependencies": {
    "@tivility/dsh-web-kit": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.1-rc.2",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "*",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  }
}
